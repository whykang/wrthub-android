<?xml version="1.0" encoding="utf-8"?>
<!--
  AI 终端,对照 iOS TerminalViewController:
  顶栏(返回 / 标题 + 连接状态 / ✦ AI / 菜单)、ttyd 页面、钉在键盘上沿的快捷键栏。
  整页固定深色,和终端本身一致。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/term_bar"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- 顶栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/term_back"
            android:src="@drawable/ic_arrow_back"
            android:tint="@android:color/white" />

        <!-- 左侧按钮与右侧两个按钮宽度不同,标题用占位保持居中 -->
        <View
            android:layout_width="44dp"
            android:layout_height="1dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/svc_ai_terminal"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/status_dot"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:layout_marginEnd="5dp" />

                <TextView
                    android:id="@+id/status_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="middle"
                    android:fontFamily="monospace"
                    android:maxWidth="220dp"
                    android:singleLine="true"
                    android:textColor="@color/term_text_dim"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_ai"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/ai_title"
            android:src="@drawable/ic_sparkles"
            android:tint="@color/ios_blue" />

        <ImageButton
            android:id="@+id/btn_menu"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/term_menu"
            android:src="@drawable/ic_more_vert"
            android:tint="@color/ios_blue" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:background="@color/term_hairline" />

    <!-- 终端区域 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/term_bg">

        <WebView
            android:id="@+id/web_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/term_bg" />

        <ProgressBar
            android:id="@+id/spinner"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/term_text_dim" />

        <!-- 出错时的居中提示:图标 + 文字 + 重试 -->
        <LinearLayout
            android:id="@+id/error_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="36dp"
            android:paddingEnd="36dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_warning"
                android:tint="#8C8C8C" />

            <TextView
                android:id="@+id/error_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:textColor="#BFBFBF"
                android:textSize="15sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_retry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="@string/term_retry"
                android:textColor="@android:color/white"
                app:backgroundTint="@color/term_key"
                app:cornerRadius="20dp"
                xmlns:app="http://schemas.android.com/apk/res-auto" />
        </LinearLayout>

        <!-- 顶部轻提示(自动登录失败、剪贴板为空等) -->
        <TextView
            android:id="@+id/banner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginStart="24dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="24dp"
            android:alpha="0"
            android:background="@drawable/bg_toast"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingTop="7dp"
            android:paddingEnd="14dp"
            android:paddingBottom="7dp"
            android:textColor="@android:color/white"
            android:textSize="13sp" />
    </FrameLayout>

    <!-- 快捷键栏:adjustResize 下自然落在键盘上沿,键盘收起时在屏幕底部 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:background="@color/term_hairline" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@color/term_bar"
        android:overScrollMode="ifContentScrolls"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/key_row"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp" />
    </HorizontalScrollView>
</LinearLayout>
